{
	"name": "fretboard-renderer",
	"version": "0.2.2",
	"description": "Render guitar fretboard diagrams from lightweight YAML in fenced code blocks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
