		"fretboard-renderer-core": "^0.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@eslint/json": "0.14.0",
		"@types/node": "^20.11.30",
		"esbuild": "^0.20.2",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "^5.4.3",
		"typescript-eslint": "^8.35.1"
	}
