{
	"name": "fretboard-renderer",
	"version": "0.1.7",
	"description": "Render guitar fretboard diagrams from lightweight YAML in fenced code blocks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": ["obsidian-plugin", "guitar", "fretboard", "music-theory"],
	"author": "Hiroshi Watanabe",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"@typescript-eslint/eslint-plugin": "^7.4.0",
		"@typescript-eslint/parser": "^7.4.0",
		"esbuild": "^0.20.2",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "^5.4.3",
		"vitest": "^1.4.0",
		"yaml": "^2.4.1"
	}
}
